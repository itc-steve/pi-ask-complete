{
  "name": "@itc-steve/pi-ask-complete",
  "version": "1.0.1",
  "description": "Pi extension: model-guided ask_user questions in a bottom panel with the transcript kept visible",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "ask-user",
    "questions",
    "tui"
  ],
  "author": {
    "name": "itc-steve",
    "url": "https://github.com/itc-steve"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itc-steve/pi-ask-complete.git"
  },
  "bugs": {
    "url": "https://github.com/itc-steve/pi-ask-complete/issues"
  },
  "homepage": "https://github.com/itc-steve/pi-ask-complete#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./index.ts",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm test"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  }
}
